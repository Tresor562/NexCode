{
  "name": "nexcode",
  "version": "1.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/materialize-brand-assets.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "audit:curriculum": "node scripts/audit-curriculum.mjs",
    "audit:mastery": "node scripts/audit-mastery-expansion.mjs",
    "audit:bots": "node scripts/audit-bot-completion.mjs",
    "audit:quality": "node scripts/audit-learning-quality.mjs && node scripts/audit-adaptive-practice.mjs && node scripts/audit-mastery-gates.mjs",
    "audit:product": "node scripts/audit-product-readiness.mjs"
  },
  "dependencies": {
    "expo": "~57.0.9",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.2",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
